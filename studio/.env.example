# Official MpVFX builds leave these empty, which disables outbound analytics.
VITE_MPVFX_TELEMETRY_HOST=
VITE_MPVFX_TELEMETRY_KEY=

# Optional HTTPS scheduling link shown only in a custom analytics-enabled build.
VITE_MPVFX_INTERVIEW_URL=

# Explicit privacy controls supported by every build.
VITE_MPVFX_NO_TELEMETRY=1
VITE_MPVFX_NO_FEEDBACK=1

