{
  "name": "mpvfx",
  "productName": "MpVFX",
  "version": "0.8.20",
  "description": "Standalone media-first nonlinear video editor",
  "private": true,
  "license": "Apache-2.0",
  "author": "MpVFX",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.2"
  },
  "files": [
    "src",
    "dist",
    "desktop-dist"
  ],
  "type": "module",
  "main": "desktop-dist/main.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "browser": "./src/index.ts",
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./tailwind-preset": {
      "import": "./src/styles/tailwind-preset.ts",
      "types": "./src/styles/tailwind-preset.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && tsup",
    "desktop:compile": "tsup --config tsup.desktop.config.ts",
    "desktop:build": "npm run build && npm run desktop:compile",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:package": "node scripts/check-desktop-packaging-node.mjs && npm run desktop:build && electron-forge package",
    "desktop:make": "node scripts/check-desktop-packaging-node.mjs && npm run desktop:build && electron-forge make",
    "desktop:make:mac:arm64": "node scripts/check-desktop-packaging-node.mjs && npm run desktop:build && electron-forge make --platform=darwin --arch=arm64",
    "desktop:make:mac:x64": "node scripts/check-desktop-packaging-node.mjs && npm run desktop:build && electron-forge make --platform=darwin --arch=x64",
    "desktop:make:windows": "node scripts/check-desktop-packaging-node.mjs && npm run desktop:build && electron-forge make --platform=win32 --arch=x64",
    "desktop:make:linux": "node scripts/check-desktop-packaging-node.mjs && npm run desktop:build && electron-forge make --platform=linux --arch=x64",
    "postinstall": "node scripts/install-redistributable-ffmpeg.mjs && node scripts/apply-exact-keyframe-writer-patch.mjs && node scripts/apply-export-capture-geometry-patch.mjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.desktop.json --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs run --exclude desktop/server.integration.test.ts && node ./node_modules/vitest/vitest.mjs run desktop/server.integration.test.ts",
    "test:timeline-virtualization": "TIMELINE_ROW_VIRTUALIZATION=on TIMELINE_ELEMENT_COUNT=50000 node tests/e2e/timeline-virtualization.mjs",
    "test:keyframes-e2e": "node tests/e2e/keyframe-workflow.mjs",
    "test:native-keyframes-e2e": "node tests/e2e/native-keyframe-workflow.mjs",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "release:check": "node ../scripts/check-release-readiness.mjs && node ../scripts/generate-third-party-notices.mjs --check",
    "notices:update": "node ../scripts/generate-third-party-notices.mjs",
    "qa:attribution:update": "node ../scripts/update-stackexchange-attribution.mjs",
    "report:sdk-cutover": "CHOKIDAR_USEPOLLING=1 vite-node src/utils/sdkCutoverPolicy.report.ts",
    "test:timeline-default": "npm run test:timeline-virtualization"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@hyperframes/core": "0.8.20",
    "@hyperframes/engine": "^0.8.21",
    "@hyperframes/parsers": "0.8.20",
    "@hyperframes/player": "0.8.20",
    "@hyperframes/producer": "^0.8.20",
    "@hyperframes/sdk": "0.8.20",
    "@hyperframes/studio-server": "0.8.20",
    "@mcp-b/global": "^5.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-virtual": "^3.14.6",
    "acorn": "^8.18.0",
    "bpm-detective": "^2.0.5",
    "chokidar": "^4.0.3",
    "esbuild": "0.28.1",
    "ffmpeg-static": "^5.3.0",
    "gsap": "^3.13.0",
    "mediabunny": "^1.45.3",
    "onnxruntime-node": "^1.21.1",
    "puppeteer": "^25.9.0",
    "puppeteer-core": "^25.9.0",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@types/node": "^22.0.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "electron": "^44.1.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.12.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.4.2",
    "vitest": "^3.2.4",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "react": "19",
    "react-dom": "19",
    "zustand": "^4.0.0 || ^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12 || 0.27.7": true,
    "@ffprobe-installer/darwin-arm64@5.0.1": true,
    "@ffprobe-installer/darwin-x64@5.1.0": true,
    "@ffprobe-installer/linux-x64@5.2.0": true,
    "@ffprobe-installer/win32-x64@5.1.0": true,
    "ffmpeg-static@5.3.0": true,
    "onnxruntime-node@1.21.1": true,
    "puppeteer@25.9.0": true,
    "electron-winstaller@5.4.4": true,
    "fs-xattr@0.3.1": true,
    "macos-alias@0.2.12": true
  }
}
