{
  "name": "mpvfx",
  "productName": "MpVFX",
  "version": "0.0.4",
  "description": "Standalone media-first nonlinear video editor",
  "private": true,
  "license": "Apache-2.0",
  "author": "MpVFX",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "24.x"
  },
  "files": [
    ".build/dist",
    ".build/desktop-dist",
    "legal"
  ],
  "type": "module",
  "main": ".build/desktop-dist/main.js",
  "scripts": {
    "dev": "npm run desktop:dev",
    "build": "npm run typecheck && npm run build:renderer && npm run desktop:compile",
    "desktop:compile": "tsup --config .configurations/tsup.desktop.config.ts",
    "desktop:build": "npm run build",
    "desktop:dev": "npm run build && electron .",
    "desktop:package": "node ../scripts/verification_checks/check-desktop-packaging-node.mjs && npm run desktop:build && electron-forge package",
    "desktop:make": "node ../scripts/verification_checks/check-desktop-packaging-node.mjs && npm run desktop:build && electron-forge make",
    "desktop:make:mac:arm64": "node ../scripts/verification_checks/check-desktop-packaging-node.mjs && npm run desktop:build && electron-forge make --platform=darwin --arch=arm64",
    "desktop:make:mac:x64": "node ../scripts/verification_checks/check-desktop-packaging-node.mjs && npm run desktop:build && electron-forge make --platform=darwin --arch=x64",
    "desktop:make:windows": "node ../scripts/verification_checks/check-desktop-packaging-node.mjs && npm run desktop:build && electron-forge make --platform=win32 --arch=x64",
    "desktop:make:linux": "node ../scripts/verification_checks/check-desktop-packaging-node.mjs && npm run desktop:build && electron-forge make --platform=linux --arch=x64",
    "postinstall": "node ../scripts/third_party/install-redistributable-ffmpeg.mjs && node ../scripts/applier/apply-exact-keyframe-writer-patch.mjs && node ../scripts/applier/apply-export-capture-geometry-patch.mjs && node ../scripts/applier/apply-readonly-preview-patch.mjs",
    "typecheck": "npm run typecheck:shared && tsc --project .configurations/tsconfig.json --noEmit && tsc --project .configurations/tsconfig.desktop.json --noEmit",
    "knip": "knip",
    "knip:production": "knip --production",
    "test": "node ../scripts/run-tests.mjs",
    "test:timeline-virtualization": "TIMELINE_ROW_VIRTUALIZATION=on TIMELINE_ELEMENT_COUNT=50000 node tests/e2e/timeline-virtualization.mjs",
    "test:keyframes-e2e": "node tests/e2e/keyframe-workflow.mjs",
    "test:native-keyframes-e2e": "node tests/e2e/native-keyframe-workflow.mjs",
    "test:watch": "node ./node_modules/vitest/vitest.mjs --config .configurations/vitest.config.ts",
    "release:check": "node ../scripts/check-release-readiness.mjs && node ../scripts/generate-third-party-notices.mjs --check",
    "notices:update": "node ../scripts/generate-third-party-notices.mjs",
    "qa:attribution:update": "node ../scripts/update-stackexchange-attribution.mjs",
    "report:sdk-cutover": "CHOKIDAR_USEPOLLING=1 vite-node src/features/legacy/sdkCutoverPolicy.report.ts",
    "test:timeline-default": "npm run test:timeline-virtualization",
    "check:architecture": "node ../scripts/verification_checks/check-architecture.mjs",
    "typecheck:shared": "tsc --project .configurations/tsconfig.shared.json --noEmit",
    "check": "npm run check:architecture && npm run typecheck && npm test && npm run desktop:build",
    "build:renderer": "vite build --config .configurations/vite.config.ts"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@hyperframes/core": "0.8.53",
    "@hyperframes/engine": "^0.8.21",
    "@hyperframes/parsers": "0.8.53",
    "@hyperframes/player": "0.8.53",
    "@hyperframes/producer": "^0.8.20",
    "@hyperframes/sdk": "0.8.53",
    "@hyperframes/studio-server": "0.8.53",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-virtual": "^3.14.6",
    "acorn": "^8.18.0",
    "bpm-detective": "^2.0.5",
    "chokidar": "^4.0.3",
    "esbuild": "0.28.2",
    "ffmpeg-static": "^5.3.0",
    "gsap": "^3.13.0",
    "linkedom": "0.18.13",
    "mediabunny": "^1.45.3",
    "puppeteer": "^25.11.0",
    "puppeteer-core": "^25.9.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@types/node": "^24.13.6",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.6.1",
    "electron": "^44.4.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.0",
    "knip": "6.37.0",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.4.2",
    "vitest": "^3.2.4",
    "zustand": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12 || 0.27.7": true,
    "@ffprobe-installer/darwin-arm64@5.0.1": true,
    "@ffprobe-installer/darwin-x64@5.1.0": true,
    "@ffprobe-installer/linux-x64@5.2.0": true,
    "@ffprobe-installer/win32-x64@5.1.0": true,
    "ffmpeg-static@5.3.0": true,
    "puppeteer@25.11.0": true,
    "electron-winstaller@5.4.4": true,
    "fs-xattr@0.3.1": true,
    "macos-alias@0.2.12": true
  },
  "config": {
    "forge": "./.configurations/forge.config.cjs"
  }
}
