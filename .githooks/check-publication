#!/bin/sh
set -eu

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

find_mpvfx_node() {
  for node_candidate in \
    "${MPVFX_NODE:-}" \
    node \
    /opt/homebrew/opt/node@24/bin/node \
    /usr/local/opt/node@24/bin/node
  do
    [ -n "$node_candidate" ] || continue
    if "$node_candidate" -e 'process.exit(process.versions.node.split(".")[0] === "24" ? 0 : 1)' \
      >/dev/null 2>&1
    then
      printf '%s\n' "$node_candidate"
      return 0
    fi
  done
  return 1
}

node_binary=$(find_mpvfx_node) || {
  printf '%s\n' \
    "MpVFX publication checks use Node.js 24 LTS. Set MPVFX_NODE to that executable." \
    >&2
  exit 1
}

# Bare `npm` resolves `node` via PATH (env shebang), as does every `node` nested
# inside npm scripts and tool shebangs, so without this the gates below would
# silently ignore the MPVFX_NODE selection above. Pin PATH to the selected
# runtime's directory so the whole publication check uses one Node.js 24.
case "$node_binary" in */*) : ;; *) node_binary=$(command -v "$node_binary");; esac
export PATH="$(dirname "$node_binary"):$PATH"

"$node_binary" scripts/verification_checks/check-release-readiness.mjs
"$node_binary" scripts/verification_checks/third-party-notices.mjs
# Dead-code gates: architecture boundaries plus Knip unused files/dependencies.
# These run here so junk never leaves the machine; CI repeats them.
npm --prefix studio run check:architecture
npm --prefix studio run check:knip
